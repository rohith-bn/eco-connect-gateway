/*
 * EcoConnect IoT Gateway - Devicetree Hardware Overlay
 * Target: STM32F407G-DISC1 (MB997)
 *
 * Pin-Choice Notes (Task 24.DT):
 *  - I2C1: PB6 (SCL), PB7 (SDA) -> Header P1, AF4, standard 100 kHz for BMP/BME280.
 *  - SPI1: PA5 (SCK), PA6 (MISO), PA7 (MOSI) -> Header P1, AF5, 4 MHz breadboard-safe.
 *  - ENC28J60 CS:  PB12 (GPIO_ACTIVE_LOW) -> Header P2, free GPIO next to SPI2/I2C2 area.
 *  - ENC28J60 INT: PB11 (GPIO_ACTIVE_LOW) -> Header P1/P2, free EXTI11 line for RX IRQ.
 */

/* Enable I2C1 Bus on PB6 (SCL) and PB7 (SDA) */
&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

/* Enable SPI1 Bus on PA5 (SCK), PA6 (MISO), PA7 (MOSI) with CS on PB12 */
&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;

	enc28j60: enc28j60@0 {
		compatible = "microchip,enc28j60";
		reg = <0>;
		spi-max-frequency = <4000000>;
		int-gpios = <&gpiob 11 GPIO_ACTIVE_LOW>;
		local-mac-address = [ 02 00 00 11 22 33 ];
		status = "okay";
	};
};
